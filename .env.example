# Copia este archivo como .env.local y completa los valores (pasos en README.md).
# .env.local está en .gitignore: NUNCA subas credenciales reales al repositorio.

# Base de datos local de desarrollo. Nunca uses la de producción.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Usa una contraseña solo con letras y números para no romper la URL.
DATABASE_URL=postgresql://riouc_dev:CAMBIA_ESTA_CLAVE@localhost:5432/riouc_dev

# NextAuth. Genera NEXTAUTH_SECRET con el comando del README.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login con Google. Opcional: solo para /tendenciaseducativas/[id].
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
